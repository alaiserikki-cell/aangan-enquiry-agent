# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values. .env* is git-ignored (except this file).

# --- App ---
APP_URL=http://localhost:3000            # public base URL, used in email links (https://<project>.vercel.app in prod)
DASHBOARD_PASSWORD=                      # single password for /dashboard
DASHBOARD_DEMO=false                     # true = dashboard shows built-in sample data (no database needed). Never on in production.
CRON_SECRET=                             # long random string; Vercel Cron sends it as "Authorization: Bearer <value>"

# --- Vaani AI (app.vaanivoice.ai, docs: https://docs.vaanivoice.ai) ---
VAANI_API_KEY=                           # Developers → API Keys (sent as X-API-Key; only needed for the call-details API)
VAANI_WEBHOOK_SECRET=                    # the Secret you type into Developers → Webhooks; verifies X-Vaani-Signature
VAANI_TOOL_SECRET=                       # sent by each Vaani custom tool as header Authorization: Bearer <value>

# --- Cal.com ---
CALCOM_API_KEY=
CALCOM_FALLBACK_ATTENDEE_EMAIL=          # optional: shared inbox put on bookings when the caller gives no email

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash             # used automatically if the main model is overloaded (503/429)

# --- Neon Postgres ---
DATABASE_URL=                            # Neon connection string (pooled), postgresql://...neon.tech/...?sslmode=require
DATABASE_URL_UNPOOLED=                   # direct (non-pooled) string, used only by npm run db:setup for schema changes

# --- HubSpot (free CRM, OPTIONAL: leave blank to run on email only; deals and the pipeline panel switch on when set) ---
HUBSPOT_ACCESS_TOKEN=                    # private app token: crm.objects.contacts.read/write, crm.objects.deals.read/write
HUBSPOT_PIPELINE_ID=default
HUBSPOT_STAGE_CONSULTATION_BOOKED=       # internal ID of the "Consultation booked" stage

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM="Aangan Studio <leads@yourdomain.com>"
EMAIL_TEST_MODE=true                     # true = every email goes to EMAIL_TEST_RECIPIENT with a [TEST] prefix
EMAIL_TEST_RECIPIENT=delivered@resend.dev

# --- People ---
NIKHIL_EMAIL=
ESCALATION_EMAIL=                        # senior person copied on existing-client complaints

# --- Cost rates (no prices in code; all in COST_CURRENCY) ---
COST_CURRENCY=INR
VAANI_COST_PER_MIN=
GEMINI_COST_PER_1M_INPUT_TOKENS=
GEMINI_COST_PER_1M_OUTPUT_TOKENS=
RESEND_COST_PER_EMAIL=
